NEXT_PUBLIC_SITE_URL=https://www.globalmart21.com

# Supabase (대시보드 > Project Settings > API)
# 비워 두면 '미리보기 모드'로 동작합니다: 예시 게시글 표시, 글쓰기·상담 접수 저장 불가
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 비밀 키 — 해외주재원 공용 비밀번호 기능에 필요. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
